# Copy to .env.local for local development, and add the same values in
# Netlify (Site configuration > Environment variables) for the live site.

# Public address of the site, without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings > API Keys) ------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key: server only, never share it.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- E-mail confirmations (resend.com) ------------------------------------
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. Royeel <commandes@royeel.com>
EMAIL_FROM=

# --- Card payment: CMI (after the business is registered) ----------------
CMI_CLIENT_ID=
CMI_STORE_KEY=
# Test gateway by default. Production: https://payment.cmi.co.ma/fim/est3Dgate
CMI_GATEWAY_URL=https://testpayment.cmi.co.ma/fim/est3Dgate

# --- Automatic WhatsApp (WhatsApp Business Cloud API, Meta-verified) ------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template with 3 body variables: {{1}} first name, {{2}} order ref,
# {{3}} total, and 2 quick-reply buttons: "Oui, je confirme" then "Non, annuler".
WHATSAPP_TEMPLATE=order_confirmation
# Meta app > App settings > Basic > App secret (checks that replies come from Meta).
WHATSAPP_APP_SECRET=
# Any long random text; type the same in Meta > WhatsApp > Configuration > Webhook,
# with the callback URL https://royeel.store/api/whatsapp/webhook (field: messages).
WHATSAPP_VERIFY_TOKEN=

# --- SMS (Twilio) ----------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Ads: server-side purchase events --------------------------------------
# Meta Events Manager > your pixel > Settings > Conversions API > access token
META_CAPI_TOKEN=
# TikTok Ads Manager > Events > your pixel > Settings > Events API access token
TIKTOK_EVENTS_TOKEN=
